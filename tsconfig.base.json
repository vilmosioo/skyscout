{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist"
  },
  "include": ["${configDir}/src/**/*"],
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "${configDir}/examples"
  ]
}
