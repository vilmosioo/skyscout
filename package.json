{
  "name": "skyscout-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for SkyScout: Open-source astrophysics clients, alert tools, and telescope scouts",
  "type": "module",
  "packageManager": "npm@8.3.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "overrides": {
    "human-id": "2.0.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@types/node": "^20.17.0",
    "tsup": "^8.3.6",
    "turbo": "^2.4.4",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
