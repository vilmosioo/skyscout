{
  "name": "@skyscout/skyview-client",
  "version": "1.0.0",
  "description": "Fully-typed TypeScript client for NASA Goddard SkyView image service, generating public-domain survey cutouts (2MASS, DSS, WISE, GALEX, SDSS)",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vilmosioo/skyscout.git",
    "directory": "packages/skyview-client"
  },
  "keywords": [
    "nasa",
    "skyview",
    "astronomy",
    "images",
    "cutout",
    "fits",
    "2mass",
    "wise",
    "dss",
    "public-domain",
    "skyscout"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
