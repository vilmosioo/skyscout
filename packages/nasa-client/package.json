{
  "name": "@skyscout/nasa-client",
  "version": "2.0.0",
  "description": "Fully-typed TypeScript client for NASA Public Domain astronomical archives: IPAC/IRSA (2MASS, AllWISE) and STScI MAST (TESS TIC, Hubble)",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vilmosioo/skyscout.git",
    "directory": "packages/nasa-client"
  },
  "keywords": [
    "nasa",
    "ipac",
    "irsa",
    "mast",
    "2mass",
    "tess",
    "allwise",
    "astronomy",
    "public-domain",
    "tap",
    "adql",
    "skyscout"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@skyscout/core": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
