{
  "name": "@skyscout/hips-client",
  "version": "1.0.0",
  "description": "Fully-typed TypeScript client for IVOA HiPS and CDS hips2fits astronomical image cutouts (DSS2 Color, 2MASS, Pan-STARRS, unWISE)",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vilmosioo/skyscout.git",
    "directory": "packages/hips-client"
  },
  "keywords": [
    "hips",
    "ivoa",
    "cds",
    "astronomy",
    "cutout",
    "fits",
    "dss2",
    "panstarrs",
    "2mass",
    "skyscout"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
